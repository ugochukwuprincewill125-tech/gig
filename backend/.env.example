# ---------------------------------------------------------------------------
# Timeline Global Systems — backend environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/timeline_db

# Where the React app runs (used for CORS, email links and payment callbacks)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177,http://localhost:5178,http://127.0.0.1:5178,http://localhost:5179,http://127.0.0.1:5179,http://localhost:5180,http://127.0.0.1:5180,http://localhost:4173,http://127.0.0.1:4173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177,http://localhost:5178,http://127.0.0.1:5178,http://localhost:5179,http://127.0.0.1:5179,http://localhost:5180,http://127.0.0.1:5180,http://localhost:4173,http://127.0.0.1:4173

# Paystack (https://dashboard.paystack.com/#/settings/developers)
# The SECRET key stays on the server only. Do not put it in the frontend.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# When no secret key is set and DEBUG=True, a clearly-labelled test mode
# lets you complete checkout locally without charging anyone.
PAYMENT_TEST_MODE=True

# Email (console backend prints emails to the terminal in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Timeline Global Systems <timelinegadget@gmail.com>

# Store settings (Naira)
LOW_STOCK_THRESHOLD=5
SHIPPING_FEE_LAGOS=3500
SHIPPING_FEE_SOUTH_WEST=5500
SHIPPING_FEE_DEFAULT=7500
FREE_SHIPPING_THRESHOLD=1000000
UNPAID_ORDER_EXPIRY_HOURS=48
REVIEWS_REQUIRE_APPROVAL=False
